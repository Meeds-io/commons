<%
  // the title is escaped once by the layout: entities a caller already wrote are decoded first
  String title = org.apache.commons.text.StringEscapeUtils.unescapeHtml4(header_title);
%>
<%=io.meeds.portal.mail.EmailLayout.darkStyle()%>
<%=io.meeds.portal.mail.EmailLayout.headerRow(io.meeds.portal.mail.EmailBrand.current(), title, _ctx.language)%>
