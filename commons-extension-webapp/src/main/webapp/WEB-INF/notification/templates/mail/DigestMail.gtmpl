<table border="0" cellpadding="0" cellspacing="0" width="600" bgcolor="${palette.surface}" align="center" class="mail-surface mail-text" style="background-color: ${palette.surface}; font-size: 14px; color: ${palette.text}; line-height: 20px; font-family: HelveticaNeue, Helvetica, Arial, sans-serif;">
  <tr>
    <td align="center" style="padding: 16px 24px 0 24px;">${logoHtml}</td>
  </tr>
  <tr>
    <td style="padding: 24px 24px 8px 24px;">
      <p style="margin: 0 0 12px 0;">${greeting}</p>
      <p style="margin: 0 0 20px 0;">${intro}</p>
    </td>
  </tr>
  <% for (section in sections) { %>
  <tr>
    <td style="padding: 0 24px 16px 24px;">
      <p class="mail-text" style="margin: 0 0 6px 0; font-weight: bold; color: ${palette.text};">${section.label} (${section.count})</p>
      <ul class="mail-text" style="margin: 0; padding-left: 20px; color: ${palette.text};">
        <% for (line in section.lines) { %>
        <li style="margin: 0 0 4px 0;">
          <% if (line.url) { %><a href="${line.url}" class="mail-link" style="color: ${palette.link}; text-decoration: none;">${line.text}</a><% } else { %>${line.text}<% } %>
        </li>
        <% } %>
      </ul>
      <% if (section.remaining > 0) { %>
      <p style="margin: 6px 0 0 20px;"><a href="${moreUrl}" class="mail-link" style="color: ${palette.link}; text-decoration: none;">${section.moreLabel}</a></p>
      <% } %>
    </td>
  </tr>
  <% } %>
  <tr>
    <td class="mail-border" style="padding: 16px 24px 24px 24px; border-top: 1px solid ${palette.border}; font-size: 13px;">
      <p style="margin: 0 0 6px 0;"><a href="${viewAllUrl}" class="mail-link" style="color: ${palette.link}; text-decoration: none;">${viewAllLabel}</a></p>
      <p style="margin: 0;"><a href="${manageUrl}" class="mail-secondary-text" style="color: ${palette.secondaryText}; text-decoration: none;">${manageLabel}</a></p>
    </td>
  </tr>
</table>
