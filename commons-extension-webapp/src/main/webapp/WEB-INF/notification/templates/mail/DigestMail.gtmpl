<%
  String font = io.meeds.portal.mail.util.EmailLayout.fontStack();
  String link = io.meeds.portal.mail.util.EmailLayout.linkColor();
  boolean rtl = io.meeds.portal.mail.util.EmailLayout.isRtl(language);
  String start = io.meeds.portal.mail.util.EmailLayout.start(language);
%>
<table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" align="center" style="width:100%;overflow-wrap:anywhere;word-break:break-word;background-color: #ffffff; font-size: 15px; color: #1d2327; line-height: 1.7; font-family: ${font};" dir="${io.meeds.portal.mail.util.EmailLayout.dir(language)}">
  <%=io.meeds.portal.mail.util.EmailLayout.darkStyle()%>
  <%=io.meeds.portal.mail.util.EmailLayout.headerRow(io.meeds.portal.mail.model.EmailBrand.current(), title, language)%>
  <tr>
    <td style="padding:0 24px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;"><tr><td align="${start}" style="padding: 30px 0 8px 0;" dir="auto">
      <p style="margin: 0 0 14px; font-size: 15px; color: #1d2327; font-family: ${font};">${greeting}</p>
      <p style="margin:0 0 14px; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${font};" dir="auto">${intro}</p>
    </td></tr></table></td>
  </tr>
  <% for (section in sections) { %>
  <tr>
    <td style="padding:0 24px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;"><tr><td align="${start}" style="padding: 0 0 16px 0;" dir="auto">
      <p style="margin:0 0 6px; color:#1d2327; line-height:1.7; font-size:15px; font-weight: bold; font-family: ${font};" dir="auto">${section.label} (${section.count})</p>
      <ul style="margin: 0; padding: ${rtl ? '0 20px 0 0' : '0 0 0 20px'}; color: #1d2327;">
        <% for (line in section.lines) { %>
        <li style="margin: 0 0 4px 0;">
          <% if (line.url) { %><a href="${line.url}" style="color: ${link}; text-decoration: underline; font-family: ${font};">${line.text}</a><% } else { %>${line.text}<% } %>
        </li>
        <% } %>
      </ul>
      <% if (section.remaining > 0) { %>
      <p style="margin: 6px ${rtl ? '20px 0 0' : '0 0 20px'}; font-size: 15px; font-family: ${font};"><a href="${moreUrl}" style="color: ${link}; text-decoration: underline; font-family: ${font};">${section.moreLabel}</a></p>
      <% } %>
    </td></tr></table></td>
  </tr>
  <% } %>
  <tr>
    <td style="padding:0 24px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;"><tr><td align="${start}" style="padding: 0 0 8px 0;" dir="auto">
      <div dir="${rtl ? 'rtl' : 'ltr'}" style="margin: 4px 0 8px 0;">
        <%=io.meeds.portal.mail.util.EmailLayout.actionLink(viewAllLabel, viewAllUrl, true)%>
      </div>
    </td></tr></table></td>
  </tr>
  <tr>
    <td style="padding:0 24px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;"><tr><td align="${start}" style="padding: 8px 0 24px 0;" dir="auto">
      <p style="margin: 0; font-size: 13px; font-family: ${font};"><a href="${manageUrl}" style="color: #5d676d; text-decoration: underline; font-family: ${font};">${manageLabel}</a></p>
    </td></tr></table></td>
  </tr>
</table>
