{
   "number_of_shards": shard.number,
   "number_of_replicas": replica.number,
   "max_regex_length": max_regex.length,
   "max_ngram_diff" : "50",
   "analysis":{
      "analyzer":{
         "default":{
            "type":"custom",
            "tokenizer":"standard",
            "filter":[
               "lowercase",
               "asciifolding"
            ]
         },
         "letter_lowercase_asciifolding":{
            "type":"custom",
            "tokenizer":"letter",
            "filter":[
               "lowercase",
               "asciifolding"
            ]
         },
         "whitespace_lowercase_asciifolding":{
            "type":"custom",
            "tokenizer":"whitespace",
            "filter":[
               "lowercase",
               "asciifolding"
            ]
         },
         "whitespace_lowercase_asciifolding_html_strip":{
            "type":"custom",
            "tokenizer":"whitespace",
            "filter":[
               "lowercase",
               "asciifolding"
            ],
            "char_filter": [
               "html_strip"
            ]
         },
         "ngram_analyzer":{
            "type":"custom",
            "tokenizer":"ngram_tokenizer",
            "filter":[
               "lowercase",
               "asciifolding"
            ]
         },
         "ngram_analyzer_search": {
           "tokenizer": "lowercase"
         }
      },
      "tokenizer":{
         "ngram_tokenizer":{
           "type": "ngram",
           "min_gram": 1,
           "max_gram": 50,
           "token_chars": [
             "letter",
             "digit"
           ]
         }
      }
   }
}