<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd">

  <!-- Managing both DB that use sequences and db that use auto increment -->
  <property name="autoIncrement" value="true" dbms="mysql,mssql,h2,hsqldb"/>
  <property name="autoIncrement" value="false" dbms="oracle,postgresql"/>

  <changeSet author="digest" id="1.0.0-1">
    <createTable tableName="NTF_DIGEST_USERS">
      <column name="ID" type="BIGINT" autoIncrement="${autoIncrement}" startWith="1">
        <constraints nullable="false" primaryKey="true" primaryKeyName="PK_NTF_DIGEST_USERS"/>
      </column>
      <column name="USER_ID" type="NVARCHAR(200)">
        <constraints nullable="false" unique="true" uniqueConstraintName="UK_NTF_DIGEST_USERS_USER_ID"/>
      </column>
      <column name="DAILY" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="WEEKLY" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="TIMEZONE" type="NVARCHAR(100)"/>
      <column name="DAILY_LAST_SENT" type="TIMESTAMP"/>
      <column name="WEEKLY_LAST_SENT" type="TIMESTAMP"/>
    </createTable>
    <modifySql dbms="mysql">
      <append value=" ENGINE=INNODB CHARSET=UTF8 COLLATE utf8_general_ci"/>
    </modifySql>
  </changeSet>

  <!-- The digest sender job selects the users to serve with these two indexes -->
  <changeSet author="digest" id="1.0.0-2">
    <createIndex tableName="NTF_DIGEST_USERS" indexName="IDX_NTF_DIGEST_USERS_DAILY">
      <column name="DAILY"/>
      <column name="DAILY_LAST_SENT"/>
    </createIndex>
    <createIndex tableName="NTF_DIGEST_USERS" indexName="IDX_NTF_DIGEST_USERS_WEEKLY">
      <column name="WEEKLY"/>
      <column name="WEEKLY_LAST_SENT"/>
    </createIndex>
  </changeSet>

  <!-- hsqldb is in the list because since Hibernate 5.6 it also generates the
       ids through a sequence, and not only oracle and postgresql -->
  <changeSet author="digest" id="1.0.0-3" dbms="oracle,postgresql,hsqldb">
    <createSequence sequenceName="SEQ_NTF_DIGEST_USER_ID" startValue="1"/>
  </changeSet>

  <changeSet author="digest" id="1.0.0-5">
    <createTable tableName="NTF_DIGEST_ITEMS">
      <column name="ID" type="BIGINT" autoIncrement="${autoIncrement}" startWith="1">
        <constraints nullable="false" primaryKey="true" primaryKeyName="PK_NTF_DIGEST_ITEMS"/>
      </column>
      <column name="USER_ID" type="NVARCHAR(200)">
        <constraints nullable="false"/>
      </column>
      <column name="PLUGIN_ID" type="NVARCHAR(200)">
        <constraints nullable="false"/>
      </column>
      <column name="CATEGORY" type="NVARCHAR(100)">
        <constraints nullable="false"/>
      </column>
      <column name="ITEM_DATE" type="TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="PARAMS" type="NVARCHAR(2000)"/>
    </createTable>
    <modifySql dbms="mysql">
      <append value=" ENGINE=INNODB CHARSET=UTF8 COLLATE utf8_general_ci"/>
    </modifySql>
  </changeSet>

  <!-- (USER_ID, ITEM_DATE) serves the assembly of one user digest, (ITEM_DATE)
       serves the safety cleanup -->
  <changeSet author="digest" id="1.0.0-6">
    <createIndex tableName="NTF_DIGEST_ITEMS" indexName="IDX_NTF_DIGEST_ITEMS_USER">
      <column name="USER_ID"/>
      <column name="ITEM_DATE"/>
    </createIndex>
    <createIndex tableName="NTF_DIGEST_ITEMS" indexName="IDX_NTF_DIGEST_ITEMS_DATE">
      <column name="ITEM_DATE"/>
    </createIndex>
  </changeSet>

  <changeSet author="digest" id="1.0.0-7" dbms="oracle,postgresql,hsqldb">
    <createSequence sequenceName="SEQ_NTF_DIGEST_ITEM_ID" startValue="1"/>
  </changeSet>

</databaseChangeLog>
